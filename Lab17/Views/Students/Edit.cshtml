@model Student
@{
    ViewData["Title"] = "Edit Student";
}

<h1 class="display-5">Edit Student</h1>
<p class="lead">Everything typed here is sent to the POST version of <code>Edit</code>.</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="YearOfStudy" class="form-label">Year of Study</label>
                <input asp-for="YearOfStudy" class="form-control" />
                <span asp-validation-for="YearOfStudy" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gpa" class="form-label">GPA</label>
                <input asp-for="Gpa" class="form-control" />
                <span asp-validation-for="Gpa" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/students" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

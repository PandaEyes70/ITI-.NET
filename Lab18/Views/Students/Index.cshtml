@{
    ViewData["Title"] = "Students";
}

@*  Session 17's confirmation banner — unchanged. TempData survives
    exactly one redirect and is then thrown away, which is why this
    appears once after saving and never on a refresh.  *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<h1 class="display-5">All Students</h1>
<p class="lead">Reached through the route pattern <code>students</code>.</p>

@*
    TODO 1: Two separate additions, both about mixing C# and HTML.

            First, directly below this comment, open a Razor CODE BLOCK —
            an at-sign followed by an opening curly brace, closed by a
            matching curly brace — and inside it declare two ordinary
            local variables from the model: the number of students, and
            their average grade point average. Use the LINQ methods from
            Session 12 for both. Nothing inside a code block is printed;
            it only computes.

   
Second, below that block, print a one-line summary sentence
            using those two variables. Print a value by writing an at-sign
            immediately followed by the variable name, with no space and
            no braces. Format the average to two decimal places using the
            same format string Session 14 used in the console.

            ⚠️ Watch the empty-list case. If the roster is empty, asking
            for an average throws. Guard the whole summary with a Razor
            `if` — an at-sign followed by the word if — that only prints
            the sentence when there is at least one student, and prints a
            short "no students yet" message otherwise.
*@

@{
    var studentCount = Model.Count();
    var averageGpa = Model.Any() ? Model.Average(s => s.Gpa) : 0.0;
}

@if (studentCount > 0)
{
    <p>
        <strong>@studentCount</strong> students on the roster , average Gpa
        <strong>@averageGpa.ToString("F2")</strong>
    </p>
}
else
{
    <p class="text-muted">No students yet. Add the first one below.</p>
}

<p><a class="btn btn-primary" asp-controller="Students" asp-action="Create">+ Add a Student</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Year</th>
            <th>GPA</th>
        </tr>
    </thead>
    <tbody>
        @*
            TODO 4: (Block 3 — after TODO 5 exists, or the page will
                    break the moment you save it.)
                    Replace the ENTIRE loop body below — the four table
                    cells, not the loop itself — with a single call to
                    the shared partial view you build in TODO 5. Use the
                    partial TAG (an HTML-looking element whose name is
                    the word partial), give it a name attribute holding
                    the partial's file name WITHOUT its extension and
                    WITHOUT a leading underscore-path, and a model
                    attribute holding the loop variable.
                    Then delete the four cells. If deleting them makes
                    you nervous, that nervousness is the point of Block 3
                    and it will be gone in ten minutes.
        *@
        @foreach (var student in Model)
        {
            @* <tr>
                <td>@student.Id</td>
                <td><a href="/students/@student.Id">@student.FullName</a></td>
                <td>@student.YearOfStudy</td>
                <td>@student.Gpa.ToString("F2")</td>
            </tr> *@
            <partial name="_StudentRow" model="student" />
        }
    </tbody>
</table>
